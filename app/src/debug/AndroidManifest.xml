<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions (merged into debug builds; absent from release). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Visual QA: renders the widget catalog to contact sheets in the app's cache. -->
        <receiver
            android:name="com.desire.widget.debug.RenderDumpReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.desire.widget.debug.RENDER_DUMP" />
                <action android:name="com.desire.widget.debug.CAPTURE_SELF" />
            </intent-filter>
        </receiver>

        <!-- Tracks our own resumed Activity for CAPTURE_SELF; serves no data. -->
        <provider
            android:name="com.desire.widget.debug.SelfCapture"
            android:authorities="${applicationId}.debug.selfcapture"
            android:exported="false" />
    </application>
</manifest>
