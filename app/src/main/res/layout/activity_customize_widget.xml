<?xml version="1.0" encoding="utf-8"?>
<!-- Editor: the live preview floats over the user's wallpaper (the window shows it); below it a
     solid sheet with the widget's own tabs ("Clock Style", "Hour Color"…), the tab's controls and
     the ✕ / ↻ / ADD NEW bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/cw_preview_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="200dp">

            <ImageView
                android:id="@+id/cw_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="36dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="28dp"
                android:contentDescription="Widget preview"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/cw_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_editor_sheet"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/cw_tabs_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/cw_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <FrameLayout
                android:id="@+id/cw_content"
                android:layout_width="match_parent"
                android:layout_height="290dp" />

            <LinearLayout
                android:id="@+id/cw_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/cw_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_round_glass"
                    android:contentDescription="Close"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/cw_reset"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_round_glass"
                    android:contentDescription="Reset"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/cw_add_home"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_premium_pill"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="24dp"
                    android:text="＋  ADD NEW"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/cw_scrim"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_top_scrim" />

</FrameLayout>
