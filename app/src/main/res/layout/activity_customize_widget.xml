<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <!-- Large live preview -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp">

        <ImageView
            android:id="@+id/cw_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="24dp"
            android:contentDescription="Widget preview"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/cw_advanced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:text="Advanced"
            android:padding="8dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:background="?selectableItemBackground" />
    </FrameLayout>

    <!-- Tab bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#14FFFFFF">

        <LinearLayout
            android:id="@+id/cw_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp" />
    </HorizontalScrollView>

    <!-- Tab content (built per tab) -->
    <FrameLayout
        android:id="@+id/cw_content"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#0AFFFFFF" />

    <!-- Bottom action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/cw_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close"
            android:background="?selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnSurface"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <ImageView
            android:id="@+id/cw_reset"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="Reset"
            android:background="?selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnSurface"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cw_add_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="＋ ADD NEW"
            android:paddingHorizontal="22dp"
            android:paddingVertical="12dp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            android:background="@drawable/bg_premium_pill" />
    </LinearLayout>

</LinearLayout>
